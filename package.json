{
  "name": "tiffinbox-website",
  "version": "0.1.0",
  "private": true,
  "description": "Tiffin Box public website and admin dashboard (Stage 3: Supabase backend)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node init && next dev",
    "build": "node init && next build",
    "start": "node init && next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:test": "bash supabase/tests/run.sh",
    "test:e2e:staging": "node --env-file-if-exists=.env.local ./node_modules/@playwright/test/cli.js test -c playwright.staging.config.ts",
    "test:staging": "node --env-file-if-exists=.env.local scripts/staging-integration.mjs",
    "test:fallback": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/verify-offline-fallback.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "next": "16.4.6",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}

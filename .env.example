# Configuration for the Tiffin Box app. NAMES and placeholders only: copy to .env.local (git-ignored) for local
# runs; on a host set them in the host's environment settings. Never commit real values. See docs/backend.md.

# ---- Public site (no secrets) ----
# Public origin of the site, used for canonical URLs, sitemap and Open Graph. No trailing slash.
# Default when unset: http://localhost:3000
SITE_URL=

# Search engines are blocked (robots.txt Disallow + noindex) unless this is exactly "true".
# Keep unset on local, preview and staging. The CEO enables it at launch.
SITE_ALLOW_INDEXING=

# ---- Supabase (server side only; the browser never receives these) ----
# Project URL and PUBLISHABLE key (formerly "anon" key) from Supabase > Project settings > API.
# The secret / service-role key is NOT used by this app and must never be added here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ---- Run-time environment ----
# local (default) | staging | production. Deployed environments MUST set this: the test-only mock backend
# (TIFFINBOX_TEST_MOCK_BACKEND) is refused when it is "staging" or "production".
APP_ENV=local
# Shown by GET /api/health (a release tag or commit). Optional.
APP_VERSION=

# ---- Publishing and cache ----
# Shared secret for POST /api/revalidate (Supabase Cron go-live notifier, smoke test). At least 16 random
# characters. While unset the endpoint answers 503. Generate with: openssl rand -base64 32
REVALIDATE_SECRET=change-me
# Where the last good copy of the published content is kept so public pages survive a backend outage
# (NFR-08). Use a persistent disk on the host (Azure App Service: a path under /home). Default: the OS temp dir.
LAST_GOOD_CONTENT_PATH=

# ---- Admin sessions (optional; defaults shown) ----
# Idle timeout in minutes and absolute session lifetime in hours (FR-13). To be confirmed with the client.
ADMIN_IDLE_MINUTES=30
ADMIN_SESSION_HOURS=12

# ---- Tests only (never set on a host) ----
# "1" serves the in-memory mock instead of Supabase for network-free unit / e2e tests (npm run test:e2e).
# Ignored when APP_ENV is staging or production.
TIFFINBOX_TEST_MOCK_BACKEND=
# Staging admin account for `npm run test:e2e:staging` (created by the Engineering Lead, STAGING only).
# Without both, the authenticated staging tests skip with a clear message.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

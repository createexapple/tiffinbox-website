# Non-secret configuration for the public site. Copy to .env.local for local overrides (never commit .env files).

# Public origin of the site, used for canonical URLs, sitemap and Open Graph. No trailing slash.
# Default when unset: http://localhost:3000
SITE_URL=

# Search engines are blocked (robots.txt Disallow + noindex) unless this is exactly "true".
# Keep unset on local, preview and staging. The CEO enables it at launch.
SITE_ALLOW_INDEXING=
